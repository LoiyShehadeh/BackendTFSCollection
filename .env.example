PORT=3000
# Primary local frontend origin
CORS_ORIGIN=http://localhost:4200
# Optional extra frontends (comma-separated), e.g. your Netlify site
# CORS_ORIGINS=https://chic-pony-669301.netlify.app

# Used to sign session cookies (set a stable value on Render)
SESSION_SECRET=change-me-to-a-long-random-string

# TFS collection base URLs (no trailing slash)
TFS_2018_URL=http://tfs2018:8080/tfs/Realsoft-Projects
TFS_2017_URL=http://tfs2017srv:8080/tfs/DefaultCollection

TFS_AUTH_MODE=ntlm
TFS_DEFAULT_DOMAIN=REALSOFT-ME

DATABASE_PATH=./data/portal.db
