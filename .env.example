PORT=3000
CORS_ORIGIN=http://localhost:4200
# Any http://localhost:<port> origin is also accepted (Angular may use 4200, 56365, etc.)

# Used to sign session cookies (set a stable value in shared environments)
SESSION_SECRET=change-me-to-a-long-random-string

# TFS collection base URLs (no trailing slash)
TFS_2018_URL=http://tfs2018:8080/tfs/Realsoft-Projects
TFS_2017_URL=http://tfs2017srv:8080/tfs/DefaultCollection

# How the API authenticates each logged-in user to TFS
# ntlm = on-prem Windows/IIS (recommended) | basic = Basic/PAT if enabled
TFS_AUTH_MODE=ntlm
# Used when login is email or bare username (NetBIOS domain, e.g. REALSOFT-ME)
TFS_DEFAULT_DOMAIN=REALSOFT-ME

# SQLite database file path
DATABASE_PATH=./data/portal.db
